{
  "name": "ecomanage",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "api": "pnpm --filter @ecomanage/api dev",
    "web": "pnpm --filter @ecomanage/web dev",
    "dev": "pnpm -r --parallel dev",
    "seed": "pnpm --filter @ecomanage/api seed",
    "server": "pnpm api",
    "client": "pnpm web",
    "start": "pnpm dev",
    "knip": "knip"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "knip": "^6.38.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1"
  },
  "license": "UNLICENSED"
}
