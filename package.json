{
  "name": "ecomanage",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "api": "pnpm --filter @ecomanage/api dev",
    "web": "pnpm --filter @ecomanage/web dev",
    "dev": "pnpm -r --parallel dev",
    "seed": "pnpm --filter @ecomanage/api seed",
    "server": "pnpm api",
    "client": "pnpm web",
    "start": "pnpm dev",
    "server-install": "pnpm install",
    "client-install": "pnpm install"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.11.0"
  },
  "license": "ISC"
}
