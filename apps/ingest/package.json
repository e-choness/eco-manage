{
  "name": "@ecomanage/ingest",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "MQTT telemetry ingest: validate, deduplicate, batch-write to the time series, update latest values",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@ecomanage/db": "workspace:*",
    "@ecomanage/profiles": "workspace:*",
    "@ecomanage/shared": "workspace:*",
    "ioredis": "^6.0.0",
    "mongoose": "^9.11.4",
    "mqtt": "^5.16.1",
    "pino": "^10.4.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
