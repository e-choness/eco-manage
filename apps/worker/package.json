{
  "name": "@ecomanage/worker",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "BullMQ jobs: interval costs and bills (later forecasts, reports, email)",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "bills:refresh": "tsx src/scripts/refreshBills.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@ecomanage/db": "workspace:*",
    "@ecomanage/shared": "workspace:*",
    "bullmq": "^6.3.9",
    "exceljs": "^4.4.0",
    "ioredis": "^6.0.0",
    "mongoose": "^9.10.2",
    "nodemailer": "^10.0.10",
    "pdfkit": "^0.20.2",
    "pino": "^10.3.1",
    "tsx": "^4.23.15",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@ecomanage/simulator": "workspace:*",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "eslint": "^10.11.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  }
