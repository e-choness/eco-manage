{
  "name": "@ecomanage/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reference edge gateway agent (Raspberry Pi 5): claim, Modbus TCP/RTU polling from profiles, OCPP 1.6J local server, 7-day buffer, commands with limits",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "fake-devices": "tsx src/bench/fake-devices.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@ecomanage/profiles": "workspace:*",
    "@ecomanage/shared": "workspace:*",
    "@peculiar/x509": "^2.1.0",
    "modbus-serial": "^8.0.25",
    "mqtt": "^5.10.1",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "tsx": "^4.23.15",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/ws": "^8.18.1",
    "eslint": "^10.11.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  }
}
