{
  "name": "@ecomanage/simulator",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Simulated site and gateway: speaks the same MQTT topics as a real gateway",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "license": "ISC",
  "dependencies": {
    "@ecomanage/profiles": "workspace:*",
    "@ecomanage/shared": "workspace:*",
    "luxon": "^3.5.0",
    "mqtt": "^5.10.1",
    "pino": "^9.5.0",
    "tsx": "^4.7.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/luxon": "^3.4.2",
    "@types/node": "^20.11.5",
    "eslint": "^9.13.0",
    "typescript": "~5.6.2",
    "vitest": "^1.6.1"
  }
}
