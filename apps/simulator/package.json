{
  "name": "@ecomanage/simulator",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./engine": "./src/engine/site.ts",
    "./gateway": "./src/gateway.ts"
  },
  "description": "Simulated site and gateway: speaks the same MQTT topics as a real gateway",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@ecomanage/profiles": "workspace:*",
    "@ecomanage/shared": "workspace:*",
    "luxon": "^3.5.0",
    "mqtt": "^5.10.1",
    "pino": "^10.3.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/luxon": "^3.4.2",
    "@types/node": "^24.19.0",
    "eslint": "^10.11.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  }
}
