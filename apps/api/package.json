{
  "name": "@ecomanage/api",
  "version": "2.0.0",
  "private": true,
  "description": "EcoManage Backend API",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "seed": "tsx src/scripts/seed.ts",
    "gateway:register": "tsx src/scripts/registerGateway.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "migrate": "tsx src/scripts/migrate.ts"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@ecomanage/db": "workspace:*",
    "@ecomanage/profiles": "workspace:*",
    "@ecomanage/recs": "workspace:*",
    "@ecomanage/shared": "workspace:*",
    "@anthropic-ai/sdk": "^0.128.0",
    "@peculiar/x509": "^2.1.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.9",
    "cors": "^2.8.5",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.0.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^7.6.0",
    "mongoose": "^9.10.2",
    "mqtt": "^5.10.1",
    "multer": "^2.4.0",
    "pino": "^10.3.1",
    "rate-limit-redis": "^6.0.1",
    "reflect-metadata": "^0.2.2",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.2.0",
    "@vitest/coverage-v8": "^5.0.2",
    "@types/node": "^26.6.3",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.11.0",
    "supertest": "^7.3.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  }
}
