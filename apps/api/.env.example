# Server Configuration
# docker-compose loads this file first, then .env (optional, gitignored) on top.
# The placeholder secrets below are for local development only.

# Port to listen on (default: 3000)
PORT=3000

# MongoDB connection URL
# Local Docker: mongodb://mongodb:27017/ecomanage
# Production: mongodb+srv://user:password@cluster.mongodb.net/database
DATABASE_URL=mongodb://mongodb:27017/ecomanage

# JWT Secrets (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your_jwt_secret_here_64_hex_chars
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here_64_hex_chars


# Browser origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5173

# Redis backs the rate limiter so limits hold across API instances
REDIS_URL=redis://redis:6379

# Rate limits per client IP per window
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# Building outlines from OpenStreetMap (Settings → Site model); empty turns the lookup off
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Plain-language explanations of recommendations (P5-05). Site owners can plug in their own key
# in Settings → Rules → Explanations (it is sealed with SECRETS_KEY). A server-wide default is
# optional; put real keys in apps/api/.env:
#   any OpenAI-compatible API:  LLM_BASE_URL=https://api.openai.com/v1  LLM_MODEL=…  LLM_API_KEY=…
#   Anthropic:                  ANTHROPIC_API_KEY=…  (LLM_MODEL defaults to claude-opus-5)
LLM_SITE_MONTHLY_TOKENS=200000
# Development only; generate a long random value for anything real. Changing it forgets saved keys.
SECRETS_KEY=dev-only-secrets-key-change-me-0123456789
# A model on the local network (http, private addresses) for site owners; off by default.
LLM_ALLOW_PRIVATE_URLS=false

LOG_LEVEL=info
