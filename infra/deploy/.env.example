# The hosted demo's settings (infra/deploy/compose.yml). Copy to infra/deploy/.env; setup.sh
# does that and fills in the secrets. Never commit the copy.

# The public address, as visitors type it (no trailing slash): CORS and links in emails.
PUBLIC_URL=https://demo.example.com

# Secrets: long and random (openssl rand -hex 32). Changing SECRETS_KEY forgets saved model keys.
JWT_SECRET=
REFRESH_TOKEN_SECRET=
SECRETS_KEY=
S3_SECRET_KEY=

# A named Cloudflare Tunnel's token (profile "tunnel"); see docs/guide/oracle.md.
TUNNEL_TOKEN=

# Images: GHCR by default; IMAGE_TAG pins a commit (sha-<short sha>) instead of the latest main.
# IMAGE_PREFIX=ghcr.io/e-choness/eco-manage
# IMAGE_TAG=main

# Email stays in Mailpit unless this points at a real SMTP server (smtps://user:pass@host:465).
# SMTP_URL=smtp://mailpit:1025
# MAIL_FROM=EcoManage demo <demo@example.com>

# Real weather for the forecasts instead of the simulator's.
# WEATHER_PROVIDER=open-meteo

# The simulated site: speed (1 = real time) and seed.
# SIM_SPEED=1
# SIM_SEED=42

# Real gateways from outside: open the broker (and port 8883 in the VCN and on the VM) and add
# the name they use to the broker's certificate.
# MQTT_PORT=8883
# MQTT_SERVER_SAN=DNS:mqtt.example.com

# A server-wide default model for explanations (owners can also add their own in Settings).
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=
LLM_SITE_MONTHLY_TOKENS=50000

LOG_LEVEL=info
